# EditorConfig - https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# PHP files
[*.php]
indent_size = 4

# JavaScript and TypeScript files
[*.{js,ts,jsx,tsx,mjs,cjs}]
indent_size = 2

# CSS and SCSS files
[*.{css,scss,sass,less}]
indent_size = 2

# HTML files
[*.{html,htm}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# PowerShell scripts
[*.{ps1,psm1,psd1}]
indent_size = 4
end_of_line = crlf

# WordPress specific
[wp-config.php]
indent_size = 4
