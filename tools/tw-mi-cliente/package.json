{
  "name": "tw-mi-cliente",
  "version": "1.0.0",
  "private": true,
  "description": "Build de Tailwind CSS estático para el tema WordPress mi-cliente-theme (réplica de code.html).",
  "scripts": {
    "build": "tailwindcss -c ./tailwind.config.js -i ./src.css -o ../../front/ecommerce/mi-cliente.local/wp-content/themes/mi-cliente-theme/assets/css/tailwind.css --minify",
    "watch": "tailwindcss -c ./tailwind.config.js -i ./src.css -o ../../front/ecommerce/mi-cliente.local/wp-content/themes/mi-cliente-theme/assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.7",
    "tailwindcss": "3.4.17"
  }
}
